@startuml 3-1-system-UC
title Dijagram obrazaca uporabe sustava
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #444444
}

'Primarni akteri
actor "A-01\nKupac" as A01
actor "A-02\nPredstavnik\nprodajnog mjesta" as A02
actor "A-03\nPredstavnik\nhumanitarne\norganizacije" as A03
actor "A-04\nAdministrator\nsustava" as A04

'Granica sustava
rectangle "Sustav" {
  usecase "UC-001\nRegistracija i prijava\nputem OAuth-a" as UC001
  usecase "UC-002\nPregled i pretraživanje\nponuda" as UC002
  usecase "UC-003\nRezervacija i plaćanje\nponude" as UC003
  usecase "UC-004\nPreuzimanje rezervacije\npotvrdom koda" as UC004
  usecase "UC-005\nPregled i otkazivanje\nrezervacije" as UC005
  usecase "UC-006\nRecenziranje\nprodajnog mjesta" as UC006
  usecase "UC-007\nPlaćanje članarine" as UC007
  usecase "UC-008\nObjava ponude ili paketa\niznenađenja" as UC008
  usecase "UC-009\nPregled donacijskih ponuda\ni slanje zahtjeva" as UC009
  usecase "UC-010\nObrada zahtjeva\nhumanitarnih organizacija" as UC010
  usecase "UC-011\nOdobravanje profila\nhumanitarne organizacije" as UC011
  usecase "UC-012\nKreiranje humanitarne akcije\ni evidencija donacija" as UC012
  usecase "UC-013\nPrijava u humanitarnu\nakciju" as UC013
  usecase "UC-014\nAdministracija sustava" as UC014
}

'Sekundarni (vanjski) akteri
actor "A-05\nPružatelj autentifikacije\n(OAuth 2.0)" as A05 <<vanjski sustav>>
actor "A-06\nServis za plaćanje\n(PayPal / kartice)" as A06 <<vanjski sustav>>
actor "A-07\nServis za karte\n(Google Maps)" as A07 <<vanjski sustav>>

'Kupac
A01 -- UC001
A01 -- UC002
A01 -- UC003
A01 -- UC005
A01 -- UC006
A01 -- UC013

'Predstavnik prodajnog mjesta
A02 -- UC001
A02 -- UC004
A02 -- UC007
A02 -- UC008
A02 -- UC010
A02 -- UC012

'Humanitarna organizacija
A03 -- UC001
A03 -- UC009
A03 -- UC012

'Administrator
A04 -- UC011
A04 -- UC014

'Sekundarni akteri
UC001 -- A05
UC002 -- A07
UC003 -- A06
UC005 -- A06
UC007 -- A06

@enduml
