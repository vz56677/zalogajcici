@startuml 3-1-rezervacije-UC-V6
' SpasiZalogaj - detaljni dijagram obrazaca uporabe: rezervacije
' Radna pretpostavka (za potvrdu s timom): kupac nakon rezerviranja odmah
' nastavlja na obvezno online placanje; nema placanja gotovinom.
' Rezervacija moze privremeno cekati potvrdu uplate tijekom tog procesa,
' ali kod za preuzimanje salje se TEK NAKON uspjesnog placanja.
' UC-022 je uvjetno prosirenje UC-015 nakon uspjesnog placanja.
' Redoslijed i uvjeti definiraju se u tekstualnom scenariju UC-003.
' UC-021 do UC-023 su privremene detaljne oznake (provjeriti s timom).

skinparam defaultFontSize 20
left to right direction

rectangle "Sustav SpasiZalogaj - rezervacije" as sustav {
    usecase "UC-003 Rezervacija i plaćanje ponude" as UC3
    usecase "UC-004 Potvrda preuzimanja ponude" as UC4
    usecase "UC-005 Otkazivanje rezervacije" as UC5
    usecase "UC-006 Recenziranje prodajnog mjesta" as UC6
    usecase "UC-015 Plaćanje putem vanjskog servisa" as UC15
    usecase "UC-021 Pregled vlastitih rezervacija" as UC21
    usecase "UC-022 Potvrda rezervacije i slanje koda" as UC22
    usecase "UC-023 Pokretanje povrata novca" as UC23

    ' Placanje je obvezan dio uspjesno dovrsene rezervacije.
    UC3 -down..> UC15 : <<include>>
    ' Nakon uspjesnog placanja potvrdi rezervaciju i posalji kod.
    UC22 -up..> UC15 : <<extend>> \n[plaćanje uspješno]

    ' Otkazivanje se moze pokrenuti tijekom pregleda vlastitih rezervacija.
    UC5 -up..> UC21 : <<extend>> \n[otkazivanje odabrano i dopušteno]

    ' Povrat novca samo kada pravila to dopuštaju.
    UC23 -up..> UC5 : <<extend>> \n[povrat odobren]
}

' Raspored aktera preuzet iz kolegicinog opceg dijagrama.
rectangle " " as Lijevo #transparent;line:transparent {
    actor Kupac
    actor "Prodajno mjesto" as PM
}

rectangle " " as Desno #transparent;line:transparent {
    actor "Servis za plaćanje" as PAY <<vanjski sustav>>
    actor "Servis za slanje e-pošte" as MAIL <<vanjski sustav>>
}

Kupac -- UC3
Kupac -- UC21
Kupac -- UC6
PM -- UC4

UC15 -- PAY
UC23 -- PAY
UC22 -- MAIL

@enduml
