@startuml 3-2-reservations-UC-V2

skinparam defaultFontSize 20
left to right direction

rectangle "Sustav SpasiZalogaj - rezervacije" as sustav {
    usecase "UC-003 Rezervacija i \nplaćanje ponude" as UC3
    usecase "UC-004 Potvrda\n preuzimanja ponude" as UC4
    usecase "UC-005 Otkazivanje \nrezervacije" as UC5
    usecase "UC-006 Recenziranje \nprodajnog mjesta" as UC6
    usecase "UC-015 Plaćanje \nputem vanjskog servisa" as UC15
    usecase "UC-021 Pregled \nvlastitih rezervacija" as UC21
    usecase "UC-022 Potvrda \nrezervacije i slanje koda" as UC22
    usecase "UC-023 Pokretanje \npovrata novca" as UC23

    ' Placanje je obvezan dio uspjesno dovrsene rezervacije.
    UC3 -down..> UC15 : <<include>>
    ' Nakon uspjesnog placanja potvrdi rezervaciju i posalji kod.
    UC22 -up..> UC3 : <<extend>> \n[plaćanje uspješno]

    ' Otkazivanje se moze pokrenuti tijekom pregleda vlastitih rezervacija.
    UC5 -up..> UC21 : <<extend>> \n[otkazivanje odabrano i dopušteno]

    ' Povrat novca samo kada pravila to dopuštaju.
    UC23 -left..> UC5 : <<extend>> \n[povrat odobren]

    UC6 -left..> UC21 : <<extend>> \n[prodajno mjesto potvrdilo preuzimanje]
}

' Raspored aktera preuzet iz kolegicinog opceg dijagrama.
rectangle " " as Lijevo #transparent;line:transparent {
    actor Kupac
    actor "Prodajno mjesto" as PM
}

rectangle " " as Desno #transparent;line:transparent {
    actor "Servis za plaćanje" as PAY <<vanjski sustav>>
    actor "Servis za slanje e-pošte" as MAIL <<vanjski sustav>>
}

Kupac -- UC3
Kupac -- UC21
PM -- UC4

UC15 -- PAY
UC23 -- PAY
UC22 -- MAIL

@enduml
