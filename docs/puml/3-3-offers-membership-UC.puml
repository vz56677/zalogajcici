@startuml 3-3-offers-membership-UC-V2
skinparam defaultFontSize 20
left to right direction

rectangle "Sustav SpasiZalogaj - članstvo i ponude" as sustav {
    ' usecase "UC-002 Pretraživanje ponuda" as UC2
    usecase "UC-007 Plaćanje članarine" as UC7
    usecase "UC-008 Objava ponude" as UC8
    usecase "UC-015 Plaćanje putem vanjskog servisa" as UC15
    ' usecase "UC-016 Prikaz ponuda na karti" as UC16
    usecase "UC-019 Objava paketa iznenađenja" as UC19
    usecase "UC-017 Uređivanje ponude" as UC17
    usecase "UC-018 Brisanje ponude" as UC18
    usecase "UC-020 Provjera aktivnog članstva" as UC20

    UC7 -down..> UC15 : <<include>>
    ' UC16 -up..> UC2 : <<extend>> \n[prikaz na karti odabran]

    UC8 -down..> UC20 : <<include>>
    UC19 -up..> UC8 : <<extend>> \n[odabran paket iznenađenja]
    UC18 -up..> UC17 : <<extend>> \n[odabrano i omogućeno brisanje]
}


actor "Prodajno mjesto" as PM
actor "Servis za plaćanje" as PAY <<vanjski sustav>>


' Kupac -- UC2
PM -- UC7
PM -- UC8
PM -- UC17
PM -- UC18

UC15 -- PAY
' UC16 -- MAPS

@enduml
