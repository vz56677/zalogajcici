# Primjer varijabli okruženja. Stvarne vrijednosti NIKAD ne upisivati ovdje.
# Lokalno: postaviti u terminalu ($env:IME = "...") ili u IntelliJ Run Configuration.
# Produkcija: Render -> Environment.

# Baza podataka (PostgreSQL; lokalno ili Neon)
DB_URL=jdbc:postgresql://localhost:5432/spasizalogaj
DB_USERNAME=postgres
DB_PASSWORD=

# Port poslužitelja (Render ga postavlja sam; lokalno zadano 8080)
PORT=8080

# Google OAuth 2.0 (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=